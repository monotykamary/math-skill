law add_sub_cancel:
  for +a: Q.Number
  for +b: Q.Number
  Q.Eq(Q.add(a, Q.add(b, Q.neg(a))), b)
def add_sub_cancel(a, b):
  +v0 = Q.neg(a)
  +v1 = Q.add(b, v0)
  +v2 = Q.add(a, v1)
  +v3 = Q.add(v0, b)
  +v4 = Q.add(a, v3)
  e0 = E.trans(v2, v2, v4, R.refl(v2), C.add_right(v1, v3, a, R.add_comm(b, v0)))
  e1 = E.trans(v2, v4, b, e0, R.add_cancel_pair(a, b))
  E.trans(v2, b, b, e1, E.sym(b, b, R.refl(b)))
