      %Equal.sym(N.Number, N.add(N.S{N.Z{}}, N.add(B.positive_value(p), B.positive_value(p))), N.add(B.positive_value(p), N.add(N.S{N.Z{}}, B.positive_value(p))), N.add_swap(N.S{N.Z{}}, B.positive_value(p), B.positive_value(p))) : {N.add(B.positive_value(p), N.add(B.positive_value(p), N.add(B.positive_value(q), N.add(B.positive_value(q), N.add(N.S{N.Z{}}, N.S{N.Z{}}))))) == N.add(_, N.add(N.S{N.Z{}}, N.add(B.positive_value(q), B.positive_value(q)))) : N.Number}
