      %Equal.sym(N.Number, N.mul(B.positive_value(p), B.positive_value(b)), N.mul(B.positive_value(b), B.positive_value(p)), N.mul_comm(B.positive_value(p), B.positive_value(b))) : {N.add(B.positive_value(b), N.add(_, N.mul(B.positive_value(p), B.positive_value(b)))) == N.mul(N.add(N.S{N.Z{}}, N.add(B.positive_value(p), B.positive_value(p))), B.positive_value(b)) : N.Number}
      %Equal.sym(N.Number, N.mul(B.positive_value(p), B.positive_value(b)), N.mul(B.positive_value(b), B.positive_value(p)), N.mul_comm(B.positive_value(p), B.positive_value(b))) : {N.add(B.positive_value(b), N.add(N.mul(B.positive_value(b), B.positive_value(p)), _)) == N.mul(N.add(N.S{N.Z{}}, N.add(B.positive_value(p), B.positive_value(p))), B.positive_value(b)) : N.Number}
      %Equal.sym(N.Number, N.add(N.S{N.Z{}}, N.add(B.positive_value(p), B.positive_value(p))), N.add(B.positive_value(p), N.add(N.S{N.Z{}}, B.positive_value(p))), N.add_swap(N.S{N.Z{}}, B.positive_value(p), B.positive_value(p))) : {N.add(B.positive_value(b), N.add(N.mul(B.positive_value(b), B.positive_value(p)), N.mul(B.positive_value(b), B.positive_value(p)))) == N.mul(_, B.positive_value(b)) : N.Number}
      %Equal.sym(N.Number, N.add(N.S{N.Z{}}, B.positive_value(p)), N.add(B.positive_value(p), N.S{N.Z{}}), N.add_comm(N.S{N.Z{}}, B.positive_value(p))) : {N.add(B.positive_value(b), N.add(N.mul(B.positive_value(b), B.positive_value(p)), N.mul(B.positive_value(b), B.positive_value(p)))) == N.mul(N.add(B.positive_value(p), _), B.positive_value(b)) : N.Number}
      %Equal.sym(N.Number, N.mul(N.add(B.positive_value(p), N.add(B.positive_value(p), N.S{N.Z{}})), B.positive_value(b)), N.add(N.mul(B.positive_value(p), B.positive_value(b)), N.mul(N.add(B.positive_value(p), N.S{N.Z{}}), B.positive_value(b))), N.mul_add(B.positive_value(p), N.add(B.positive_value(p), N.S{N.Z{}}), B.positive_value(b))) : {N.add(B.positive_value(b), N.add(N.mul(B.positive_value(b), B.positive_value(p)), N.mul(B.positive_value(b), B.positive_value(p)))) == _ : N.Number}
