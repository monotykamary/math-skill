law positive_mul_correct:
  for +a: B.Positive
  for +b: B.Positive
  {B.positive_value(B.positive_mul(a, b)) == N.mul(B.positive_value(a), B.positive_value(b)) : N.Number}
def positive_mul_correct(a, b):
  match a:
    case B.One{}:
      %Equal.sym(N.Number, N.mul(N.S{N.Z{}}, B.positive_value(b)), B.positive_value(b), N.add_zero(B.positive_value(b))) : {B.positive_value(b) == _ : N.Number}
      {==}
    case B.Bit0{p}:
      %Equal.sym(N.Number, B.positive_value(B.positive_mul(p, b)), N.mul(B.positive_value(p), B.positive_value(b)), positive_mul_correct(p, b)) : {N.add(_, _) == N.mul(N.add(B.positive_value(p), B.positive_value(p)), B.positive_value(b)) : N.Number}
      %Equal.sym(N.Number, N.mul(B.positive_value(p), B.positive_value(b)), N.mul(B.positive_value(b), B.positive_value(p)), N.mul_comm(B.positive_value(p), B.positive_value(b))) : {N.add(_, N.mul(B.positive_value(p), B.positive_value(b))) == N.mul(N.add(B.positive_value(p), B.positive_value(p)), B.positive_value(b)) : N.Number}
      %Equal.sym(N.Number, N.mul(B.positive_value(p), B.positive_value(b)), N.mul(B.positive_value(b), B.positive_value(p)), N.mul_comm(B.positive_value(p), B.positive_value(b))) : {N.add(N.mul(B.positive_value(b), B.positive_value(p)), _) == N.mul(N.add(B.positive_value(p), B.positive_value(p)), B.positive_value(b)) : N.Number}
      %Equal.sym(N.Number, N.mul(N.add(B.positive_value(p), B.positive_value(p)), B.positive_value(b)), N.add(N.mul(B.positive_value(p), B.positive_value(b)), N.mul(B.positive_value(p), B.positive_value(b))), N.mul_add(B.positive_value(p), B.positive_value(p), B.positive_value(b))) : {N.add(N.mul(B.positive_value(b), B.positive_value(p)), N.mul(B.positive_value(b), B.positive_value(p))) == _ : N.Number}
      %Equal.sym(N.Number, N.mul(B.positive_value(p), B.positive_value(b)), N.mul(B.positive_value(b), B.positive_value(p)), N.mul_comm(B.positive_value(p), B.positive_value(b))) : {N.add(N.mul(B.positive_value(b), B.positive_value(p)), N.mul(B.positive_value(b), B.positive_value(p))) == N.add(_, N.mul(B.positive_value(p), B.positive_value(b))) : N.Number}
      %Equal.sym(N.Number, N.mul(B.positive_value(p), B.positive_value(b)), N.mul(B.positive_value(b), B.positive_value(p)), N.mul_comm(B.positive_value(p), B.positive_value(b))) : {N.add(N.mul(B.positive_value(b), B.positive_value(p)), N.mul(B.positive_value(b), B.positive_value(p))) == N.add(N.mul(B.positive_value(b), B.positive_value(p)), _) : N.Number}
      {==}
    case B.Bit1{p}:
