law add_correct:
  for +a: B.Whole
  for +b: B.Whole
  {B.value(B.add(a, b)) == N.add(B.value(a), B.value(b)) : N.Number}
def add_correct(a, b):
  match a b:
    case B.Zero{} b:
      %Equal.sym(N.Number, N.add(N.Z{}, B.value(b)), B.value(b), {==}) : {B.value(b) == _ : N.Number}
      {==}
    case B.Pos{p} B.Zero{}:
      %Equal.sym(N.Number, N.add(B.positive_value(p), N.Z{}), B.positive_value(p), N.add_zero(B.positive_value(p))) : {B.positive_value(p) == _ : N.Number}
      {==}
    case B.Pos{p} B.Pos{q}:
      %Equal.sym(N.Number, B.positive_value(B.positive_add(p, q)), N.add(B.positive_value(p), B.positive_value(q)), positive_add_correct(p, q)) : {_ == N.add(B.positive_value(p), B.positive_value(q)) : N.Number}
      {==}

law mul_correct:
  for +a: B.Whole
  for +b: B.Whole
  {B.value(B.mul(a, b)) == N.mul(B.value(a), B.value(b)) : N.Number}
def mul_correct(a, b):
  match a b:
    case B.Zero{} b:
      %Equal.sym(N.Number, N.mul(N.Z{}, B.value(b)), N.Z{}, {==}) : {N.Z{} == _ : N.Number}
      {==}
    case B.Pos{p} B.Zero{}:
      %Equal.sym(N.Number, N.mul(B.positive_value(p), N.Z{}), N.Z{}, N.mul_zero(B.positive_value(p))) : {N.Z{} == _ : N.Number}
      {==}
    case B.Pos{p} B.Pos{q}:
      %Equal.sym(N.Number, B.positive_value(B.positive_mul(p, q)), N.mul(B.positive_value(p), B.positive_value(q)), positive_mul_correct(p, q)) : {_ == N.mul(B.positive_value(p), B.positive_value(q)) : N.Number}
      {==}
