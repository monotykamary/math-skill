      %Equal.sym(N.Number, N.mul(N.add(B.positive_value(p), N.S{N.Z{}}), B.positive_value(b)), N.add(N.mul(B.positive_value(p), B.positive_value(b)), N.mul(N.S{N.Z{}}, B.positive_value(b))), N.mul_add(B.positive_value(p), N.S{N.Z{}}, B.positive_value(b))) : {N.add(B.positive_value(b), N.add(N.mul(B.positive_value(b), B.positive_value(p)), N.mul(B.positive_value(b), B.positive_value(p)))) == N.add(N.mul(B.positive_value(b), B.positive_value(p)), _) : N.Number}
      %Equal.sym(N.Number, N.mul(B.positive_value(p), B.positive_value(b)), N.mul(B.positive_value(b), B.positive_value(p)), N.mul_comm(B.positive_value(p), B.positive_value(b))) : {N.add(B.positive_value(b), N.add(N.mul(B.positive_value(b), B.positive_value(p)), N.mul(B.positive_value(b), B.positive_value(p)))) == N.add(N.mul(B.positive_value(b), B.positive_value(p)), N.add(_, N.mul(N.S{N.Z{}}, B.positive_value(b)))) : N.Number}
