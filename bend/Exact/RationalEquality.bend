law sym:
  for +a: Q.Number
  for +b: Q.Number
  for e: Q.Eq(a, b)
  Q.Eq(b, a)
def sym(a, b, e):
  match a b e:
    case Q.Fraction{ap, an, ad} Q.Fraction{bp, bn, bd} Q.Witness{e}:
      Q.Witness{Equal.sym(N.Number,
        N.add(N.mul(B.value(ap), B.positive_value(bd)), N.mul(B.value(bn), B.positive_value(ad))),
        N.add(N.mul(B.value(bp), B.positive_value(ad)), N.mul(B.value(an), B.positive_value(bd))), e)}

law cancel_positive:
  for +k: B.Positive
  for +b: N.Number
  for +c: N.Number
  {N.mul(B.positive_value(k), b) == N.mul(B.positive_value(k), c) : N.Number} -> {b == c : N.Number}
def cancel_positive(k, b, c):
  %Equal.sym(N.Number, B.positive_value(k), N.S{C.positive_tail(k)}, C.positive(k)) : {N.mul(_, b) == N.mul(_, c) : N.Number} -> {b == c : N.Number}
  e => C.mul_cancel(b, c, C.positive_tail(k), e)

