      +v1 = B.value(B.add(B.mul(B.add(B.mul(ap, bn), B.mul(an, bp)), B.Pos{B.positive_mul(ad, cd)}), B.mul(B.add(B.mul(ap, cn), B.mul(an, cp)), B.Pos{B.positive_mul(ad, bd)})))
      +v2 = B.positive_value(B.positive_mul(ad, B.positive_mul(bd, cd)))
      +v3 = N.mul(v1, v2)
      +v4 = B.value(B.add(B.mul(B.add(B.mul(ap, bp), B.mul(an, bn)), B.Pos{B.positive_mul(ad, cd)}), B.mul(B.add(B.mul(ap, cp), B.mul(an, cn)), B.Pos{B.positive_mul(ad, bd)})))
