law add_cancel_pair:
  for +a: Q.Number
  for +b: Q.Number
  Q.Eq(Q.add(a, Q.add(Q.neg(a), b)), b)
def add_cancel_pair(a, b):
  match a b:
    case Q.Fraction{ap, an, ad} Q.Fraction{bp, bn, bd}:
      +v0 = B.positive_value(bd)
      +v1 = B.value(bn)
      +v2 = B.positive_value(B.positive_mul(ad, B.positive_mul(ad, bd)))
      +v3 = N.mul(v1, v2)
      +v4 = B.value(bp)
      +v5 = N.mul(v4, v2)
      +v6 = B.value(B.add(B.mul(an, B.Pos{B.positive_mul(ad, bd)}), B.mul(B.add(B.mul(ap, B.Pos{bd}), B.mul(bn, B.Pos{ad})), B.Pos{ad})))
