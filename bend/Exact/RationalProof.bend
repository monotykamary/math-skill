law add_neg:
  for +a: Q.Number
  Q.Eq(Q.add(a, Q.neg(a)), Q.zero())
def add_neg(a):
  match a:
    case Q.Fraction{ap, an, ad}:
      +v0 = B.positive_value(B.One{})
      +v1 = B.value(B.Zero{})
