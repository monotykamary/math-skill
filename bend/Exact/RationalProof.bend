      +v6 = N.add(v3, v5)
      +v7 = B.value(B.add(B.mul(ap, B.Pos{ad}), B.mul(an, B.Pos{ad})))
      +v8 = B.value(B.mul(ap, B.Pos{ad}))
      +v9 = B.value(B.mul(an, B.Pos{ad}))
      +v10 = N.add(v8, v9)
      +v11 = B.value(ap)
      +v12 = B.value(B.Pos{ad})
      +v13 = N.mul(v11, v12)
      +v14 = B.positive_value(ad)
      +v15 = N.mul(v11, v14)
      +v16 = B.value(an)
      +v17 = N.mul(v16, v12)
      +v18 = N.mul(v16, v14)
      +v19 = N.add(v15, v18)
      +v20 = N.mul(v19, N.S{N.Z{}})
      +v21 = N.mul(v14, v14)
      +v22 = N.mul(N.Z{}, v21)
      +v23 = N.add(v20, v22)
      +v24 = N.add(v9, v8)
      +v25 = N.add(v18, v15)
      +v26 = N.mul(v25, N.S{N.Z{}})
      +v27 = N.add(v22, v26)
      +v28 = N.mul(v14, v11)
      +v29 = N.mul(v14, v16)
      +v30 = N.add(v28, v29)
      +v31 = N.add(v29, v28)
      +v32 = N.mul(v31, N.S{N.Z{}})
      +v33 = N.add(v31, N.Z{})
      +v34 = N.add(N.Z{}, v31)
      Q.Witness{(
      %Equal.sym(N.Number, v7, v10, BP.add_correct(B.mul(ap, B.Pos{ad}), B.mul(an, B.Pos{ad}))) : {N.add(N.mul(_, v0), v3) == v6 : N.Number}
      %Equal.sym(N.Number, v8, v13, BP.mul_correct(ap, B.Pos{ad})) : {N.add(N.mul(N.add(_, v9), v0), v3) == v6 : N.Number}
      %Equal.sym(N.Number, v12, v14, {==}) : {N.add(N.mul(N.add(N.mul(v11, _), v9), v0), v3) == v6 : N.Number}
      %Equal.sym(N.Number, v9, v17, BP.mul_correct(an, B.Pos{ad})) : {N.add(N.mul(N.add(v15, _), v0), v3) == v6 : N.Number}
      %Equal.sym(N.Number, v12, v14, {==}) : {N.add(N.mul(N.add(v15, N.mul(v16, _)), v0), v3) == v6 : N.Number}
      %Equal.sym(N.Number, v0, N.S{N.Z{}}, {==}) : {N.add(N.mul(v19, _), v3) == v6 : N.Number}
      %Equal.sym(N.Number, v1, N.Z{}, {==}) : {N.add(v20, N.mul(_, v2)) == v6 : N.Number}
      %Equal.sym(N.Number, v2, v21, BP.positive_mul_correct(ad, ad)) : {N.add(v20, N.mul(N.Z{}, _)) == v6 : N.Number}
      %Equal.sym(N.Number, v1, N.Z{}, {==}) : {v23 == N.add(N.mul(_, v2), v5) : N.Number}
      %Equal.sym(N.Number, v2, v21, BP.positive_mul_correct(ad, ad)) : {v23 == N.add(N.mul(N.Z{}, _), v5) : N.Number}
      %Equal.sym(N.Number, v4, v24, BP.add_correct(B.mul(an, B.Pos{ad}), B.mul(ap, B.Pos{ad}))) : {v23 == N.add(v22, N.mul(_, v0)) : N.Number}
      %Equal.sym(N.Number, v9, v17, BP.mul_correct(an, B.Pos{ad})) : {v23 == N.add(v22, N.mul(N.add(_, v8), v0)) : N.Number}
      %Equal.sym(N.Number, v12, v14, {==}) : {v23 == N.add(v22, N.mul(N.add(N.mul(v16, _), v8), v0)) : N.Number}
      %Equal.sym(N.Number, v8, v13, BP.mul_correct(ap, B.Pos{ad})) : {v23 == N.add(v22, N.mul(N.add(v18, _), v0)) : N.Number}
