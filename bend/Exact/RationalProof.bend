      %Equal.sym(N.Number, v25, N.Z{}, {==}) : {N.add(N.mul(_, N.S{N.Z{}}), v22) == v24 : N.Number}
      %Equal.sym(N.Number, v26, N.Z{}, {==}) : {N.add(_, v22) == v24 : N.Number}
      %Equal.sym(N.Number, v21, v19, N.mul_one(v19)) : {N.add(N.Z{}, N.mul(N.Z{}, _)) == v24 : N.Number}
      %Equal.sym(N.Number, v27, N.Z{}, {==}) : {N.add(N.Z{}, _) == v24 : N.Number}
      %Equal.sym(N.Number, v25, N.Z{}, {==}) : {_ == v24 : N.Number}
      %Equal.sym(N.Number, v21, v19, N.mul_one(v19)) : {N.Z{} == N.add(N.mul(N.Z{}, _), v18) : N.Number}
      %Equal.sym(N.Number, v27, N.Z{}, {==}) : {N.Z{} == N.add(_, v18) : N.Number}
      %Equal.sym(N.Number, v12, N.Z{}, N.mul_zero(v10)) : {N.Z{} == N.add(N.Z{}, N.mul(N.add(_, v16), N.S{N.Z{}})) : N.Number}
      %Equal.sym(N.Number, v16, N.Z{}, N.mul_zero(v14)) : {N.Z{} == N.add(N.Z{}, N.mul(N.add(N.Z{}, _), N.S{N.Z{}})) : N.Number}
      %Equal.sym(N.Number, v25, N.Z{}, {==}) : {N.Z{} == N.add(N.Z{}, N.mul(_, N.S{N.Z{}})) : N.Number}
      %Equal.sym(N.Number, v26, N.Z{}, {==}) : {N.Z{} == N.add(N.Z{}, _) : N.Number}
      %Equal.sym(N.Number, v25, N.Z{}, {==}) : {N.Z{} == _ : N.Number}
      {==}
      )}

law mul_one:
  for +a: Q.Number
  Q.Eq(Q.mul(a, Q.one()), a)
def mul_one(a):
  match a:
    case Q.Fraction{ap, an, ad}:
      +v0 = B.positive_value(ad)
      +v1 = B.value(an)
      +v2 = B.positive_value(B.positive_mul(ad, B.One{}))
      +v3 = N.mul(v1, v2)
      +v4 = B.value(ap)
      +v5 = N.mul(v4, v2)
      +v6 = B.value(B.add(B.mul(ap, B.Zero{}), B.mul(an, B.Pos{B.One{}})))
      +v7 = N.mul(v6, v0)
      +v8 = N.add(v5, v7)
      +v9 = B.value(B.add(B.mul(ap, B.Pos{B.One{}}), B.mul(an, B.Zero{})))
      +v10 = B.value(B.mul(ap, B.Pos{B.One{}}))
      +v11 = B.value(B.mul(an, B.Zero{}))
      +v12 = N.add(v10, v11)
      +v13 = B.value(B.Pos{B.One{}})
      +v14 = N.mul(v4, v13)
      +v15 = B.positive_value(B.One{})
      +v16 = N.mul(v4, N.S{N.Z{}})
      +v17 = B.value(B.Zero{})
      +v18 = N.mul(v1, v17)
      +v19 = N.mul(v1, N.Z{})
      +v20 = N.add(v16, v19)
      +v21 = N.mul(v20, v0)
      +v22 = N.mul(v0, v15)
      +v23 = N.mul(v0, N.S{N.Z{}})
      +v24 = N.mul(v1, v23)
      +v25 = N.add(v21, v24)
      +v26 = N.mul(v4, v23)
      +v27 = B.value(B.mul(ap, B.Zero{}))
      +v28 = B.value(B.mul(an, B.Pos{B.One{}}))
      +v29 = N.add(v27, v28)
      +v30 = N.mul(v4, v17)
      +v31 = N.mul(v4, N.Z{})
      +v32 = N.mul(v1, v13)
      +v33 = N.mul(v1, N.S{N.Z{}})
      +v34 = N.add(v31, v33)
      +v35 = N.mul(v34, v0)
      +v36 = N.add(v26, v35)
      +v37 = N.add(v4, N.Z{})
      +v38 = N.mul(v4, v0)
      +v39 = N.mul(v0, v4)
      +v40 = N.mul(v1, v0)
      +v41 = N.mul(v0, v1)
      +v42 = N.add(v39, v41)
      +v43 = N.add(v41, v39)
      +v44 = N.add(N.Z{}, v1)
      Q.Witness{(
      %Equal.sym(N.Number, v9, v12, BP.add_correct(B.mul(ap, B.Pos{B.One{}}), B.mul(an, B.Zero{}))) : {N.add(N.mul(_, v0), v3) == v8 : N.Number}
      %Equal.sym(N.Number, v10, v14, BP.mul_correct(ap, B.Pos{B.One{}})) : {N.add(N.mul(N.add(_, v11), v0), v3) == v8 : N.Number}
      %Equal.sym(N.Number, v13, v15, {==}) : {N.add(N.mul(N.add(N.mul(v4, _), v11), v0), v3) == v8 : N.Number}
      %Equal.sym(N.Number, v15, N.S{N.Z{}}, {==}) : {N.add(N.mul(N.add(N.mul(v4, _), v11), v0), v3) == v8 : N.Number}
      %Equal.sym(N.Number, v11, v18, BP.mul_correct(an, B.Zero{})) : {N.add(N.mul(N.add(v16, _), v0), v3) == v8 : N.Number}
      %Equal.sym(N.Number, v17, N.Z{}, {==}) : {N.add(N.mul(N.add(v16, N.mul(v1, _)), v0), v3) == v8 : N.Number}
      %Equal.sym(N.Number, v2, v22, BP.positive_mul_correct(ad, B.One{})) : {N.add(v21, N.mul(v1, _)) == v8 : N.Number}
      %Equal.sym(N.Number, v15, N.S{N.Z{}}, {==}) : {N.add(v21, N.mul(v1, N.mul(v0, _))) == v8 : N.Number}
      %Equal.sym(N.Number, v2, v22, BP.positive_mul_correct(ad, B.One{})) : {v25 == N.add(N.mul(v4, _), v7) : N.Number}
      %Equal.sym(N.Number, v15, N.S{N.Z{}}, {==}) : {v25 == N.add(N.mul(v4, N.mul(v0, _)), v7) : N.Number}
      %Equal.sym(N.Number, v6, v29, BP.add_correct(B.mul(ap, B.Zero{}), B.mul(an, B.Pos{B.One{}}))) : {v25 == N.add(v26, N.mul(_, v0)) : N.Number}
      %Equal.sym(N.Number, v27, v30, BP.mul_correct(ap, B.Zero{})) : {v25 == N.add(v26, N.mul(N.add(_, v28), v0)) : N.Number}
      %Equal.sym(N.Number, v17, N.Z{}, {==}) : {v25 == N.add(v26, N.mul(N.add(N.mul(v4, _), v28), v0)) : N.Number}
      %Equal.sym(N.Number, v28, v32, BP.mul_correct(an, B.Pos{B.One{}})) : {v25 == N.add(v26, N.mul(N.add(v31, _), v0)) : N.Number}
      %Equal.sym(N.Number, v13, v15, {==}) : {v25 == N.add(v26, N.mul(N.add(v31, N.mul(v1, _)), v0)) : N.Number}
      %Equal.sym(N.Number, v15, N.S{N.Z{}}, {==}) : {v25 == N.add(v26, N.mul(N.add(v31, N.mul(v1, _)), v0)) : N.Number}
      %Equal.sym(N.Number, v16, v4, N.mul_one(v4)) : {N.add(N.mul(N.add(_, v19), v0), v24) == v36 : N.Number}
      %Equal.sym(N.Number, v19, N.Z{}, N.mul_zero(v1)) : {N.add(N.mul(N.add(v4, _), v0), v24) == v36 : N.Number}
      %Equal.sym(N.Number, v37, v4, N.add_zero(v4)) : {N.add(N.mul(_, v0), v24) == v36 : N.Number}
      %Equal.sym(N.Number, v38, v39, N.mul_comm(v4, v0)) : {N.add(_, v24) == v36 : N.Number}
      %Equal.sym(N.Number, v23, v0, N.mul_one(v0)) : {N.add(v39, N.mul(v1, _)) == v36 : N.Number}
      %Equal.sym(N.Number, v40, v41, N.mul_comm(v1, v0)) : {N.add(v39, _) == v36 : N.Number}
      %Equal.sym(N.Number, v42, v43, N.add_comm(v39, v41)) : {_ == v36 : N.Number}
      %Equal.sym(N.Number, v23, v0, N.mul_one(v0)) : {v43 == N.add(N.mul(v4, _), v35) : N.Number}
      %Equal.sym(N.Number, v38, v39, N.mul_comm(v4, v0)) : {v43 == N.add(_, v35) : N.Number}
      %Equal.sym(N.Number, v31, N.Z{}, N.mul_zero(v4)) : {v43 == N.add(v39, N.mul(N.add(_, v33), v0)) : N.Number}
      %Equal.sym(N.Number, v33, v1, N.mul_one(v1)) : {v43 == N.add(v39, N.mul(N.add(N.Z{}, _), v0)) : N.Number}
      %Equal.sym(N.Number, v44, v1, {==}) : {v43 == N.add(v39, N.mul(_, v0)) : N.Number}
      %Equal.sym(N.Number, v40, v41, N.mul_comm(v1, v0)) : {v43 == N.add(v39, _) : N.Number}
      %Equal.sym(N.Number, v42, v43, N.add_comm(v39, v41)) : {v43 == _ : N.Number}
      {==}
      )}

law mul_comm:
  for +a: Q.Number
  for +b: Q.Number
  Q.Eq(Q.mul(a, b), Q.mul(b, a))
def mul_comm(a, b):
  match a b:
    case Q.Fraction{ap, an, ad} Q.Fraction{bp, bn, bd}:
      +v0 = B.positive_value(B.positive_mul(bd, ad))
      +v1 = B.value(B.add(B.mul(bp, an), B.mul(bn, ap)))
      +v2 = B.positive_value(B.positive_mul(ad, bd))
      +v3 = N.mul(v1, v2)
      +v4 = B.value(B.add(B.mul(bp, ap), B.mul(bn, an)))
      +v5 = N.mul(v4, v2)
      +v6 = B.value(B.add(B.mul(ap, bn), B.mul(an, bp)))
      +v7 = N.mul(v6, v0)
      +v8 = N.add(v5, v7)
      +v9 = B.value(B.add(B.mul(ap, bp), B.mul(an, bn)))
      +v10 = B.value(B.mul(ap, bp))
      +v11 = B.value(B.mul(an, bn))
      +v12 = N.add(v10, v11)
      +v13 = B.value(ap)
