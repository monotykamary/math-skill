law mul_add:
  for +a: Q.Number
  for +b: Q.Number
  for +c: Q.Number
  Q.Eq(Q.mul(a, Q.add(b, c)), Q.add(Q.mul(a, b), Q.mul(a, c)))
def mul_add(a, b, c):
  match a b c:
    case Q.Fraction{ap, an, ad} Q.Fraction{bp, bn, bd} Q.Fraction{cp, cn, cd}:
