law cool_contracts_deficit:
  for +a: Q.Number
  for +b: Q.Number
  for +c: Q.Number
  Q.Eq(Q.sub(Q.mul(a, b), Q.mul(a, c)), Q.mul(a, Q.sub(b, c)))
def cool_contracts_deficit(a, b, c):
  match a b c:
    case Q.Fraction{ap, an, ad} Q.Fraction{bp, bn, bd} Q.Fraction{cp, cn, cd}:
      +v0 = B.positive_value(B.positive_mul(ad, B.positive_mul(bd, cd)))
      +v1 = B.value(B.add(B.mul(ap, B.add(B.mul(bn, B.Pos{cd}), B.mul(cp, B.Pos{bd}))), B.mul(an, B.add(B.mul(bp, B.Pos{cd}), B.mul(cn, B.Pos{bd})))))
      +v2 = B.positive_value(B.positive_mul(B.positive_mul(ad, bd), B.positive_mul(ad, cd)))
      +v3 = N.mul(v1, v2)
      +v4 = B.value(B.add(B.mul(ap, B.add(B.mul(bp, B.Pos{cd}), B.mul(cn, B.Pos{bd}))), B.mul(an, B.add(B.mul(bn, B.Pos{cd}), B.mul(cp, B.Pos{bd})))))
      +v5 = N.mul(v4, v2)
