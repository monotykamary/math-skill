law neg_neg:
  for +a: Q.Number
  Q.Eq(Q.neg(Q.neg(a)), a)
def neg_neg(a):
  match a:
    case Q.Fraction{ap, an, ad}:
      +v0 = B.value(ap)
      +v1 = B.positive_value(ad)
      +v2 = B.value(an)
      +v3 = N.mul(v2, v1)
      +v4 = N.mul(v0, v1)
      +v5 = N.add(v4, v3)
      +v6 = N.mul(v1, v0)
      +v7 = N.mul(v1, v2)
      +v8 = N.add(v6, v7)
      +v9 = N.add(v7, v6)
      Q.Witness{(
      %Equal.sym(N.Number, v4, v6, N.mul_comm(v0, v1)) : {N.add(_, v3) == v5 : N.Number}
      %Equal.sym(N.Number, v3, v7, N.mul_comm(v2, v1)) : {N.add(v6, _) == v5 : N.Number}
      %Equal.sym(N.Number, v8, v9, N.add_comm(v6, v7)) : {_ == v5 : N.Number}
