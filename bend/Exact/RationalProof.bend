  for +a: Q.Number
  for +b: Q.Number
  for +c: Q.Number
  Q.Eq(Q.sub(Q.mul(a, Q.sub(Q.one(), Q.mul(b, c))), Q.mul(a, Q.sub(Q.one(), c))), Q.mul(Q.mul(a, Q.sub(Q.one(), b)), c))
