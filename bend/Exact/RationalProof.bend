      +v5 = N.mul(v4, v0)
      +v6 = N.add(v3, v5)
      +v7 = B.value(B.mul(ap, B.Zero{}))
      +v8 = B.value(B.mul(an, B.Zero{}))
      +v9 = N.add(v7, v8)
      +v10 = B.value(ap)
      +v11 = N.mul(v10, v1)
      +v12 = N.mul(v10, N.Z{})
      +v13 = N.mul(N.Z{}, v2)
      +v14 = B.value(an)
      +v15 = N.mul(v14, v1)
      +v16 = N.mul(v14, N.Z{})
      +v17 = N.add(v12, v16)
      +v18 = N.mul(v17, N.S{N.Z{}})
      +v19 = B.positive_value(ad)
      +v20 = N.mul(v19, v0)
      +v21 = N.mul(v19, N.S{N.Z{}})
      +v22 = N.mul(N.Z{}, v21)
      +v23 = N.add(v18, v22)
      +v24 = N.add(v22, v18)
      +v25 = N.add(N.Z{}, N.Z{})
      +v26 = N.mul(N.Z{}, N.S{N.Z{}})
      +v27 = N.mul(N.Z{}, v19)
      Q.Witness{(
      %Equal.sym(N.Number, v4, v9, BP.add_correct(B.mul(ap, B.Zero{}), B.mul(an, B.Zero{}))) : {N.add(N.mul(_, v0), v3) == v6 : N.Number}
