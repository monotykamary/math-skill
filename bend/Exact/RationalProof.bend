      %Equal.sym(N.Number, v34, v31, {==}) : {v31 == _ : N.Number}
      {==}
      )}

law mul_zero:
  for +a: Q.Number
  Q.Eq(Q.mul(a, Q.zero()), Q.zero())
def mul_zero(a):
  match a:
    case Q.Fraction{ap, an, ad}:
      +v0 = B.positive_value(B.One{})
      +v1 = B.value(B.Zero{})
      +v2 = B.positive_value(B.positive_mul(ad, B.One{}))
      +v3 = N.mul(v1, v2)
